// SPDX-License-Identifier: AGPL-3.0-or-later
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarebox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true, "redact_query_string": true },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "AccountDO" },
      { "name": "SPACE", "class_name": "SpaceDO" }
    ]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "flarebox" }],
  "assets": { "directory": "./web/dist", "binding": "ASSETS" },
  "build": { "command": "pnpm --filter flarebox-web build" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountDO", "SpaceDO"] }
  ]
}
