        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ on another device removed %2$@ of %3$@ in this folder. The server decides, so Koidrive applied them here; the files are in the folder's local trash."
          }
        }
      }
    },
