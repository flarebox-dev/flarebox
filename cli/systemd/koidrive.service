#
# The Koidrive sync daemon as a systemd user service. koi installs it when you link a folder: it writes this unit with
# its own path in ExecStart and the profile's XDG directories, then enables and starts it. Unlinking the last folder
# removes it. Logs: journalctl --user -u koidrive

[Unit]
Description=Koidrive sync daemon
Documentation=https://github.com/koidrive/koidrive

[Service]
Type=exec
ExecStart=koi _daemon
Restart=on-failure
RestartSec=10s
Environment=KOIDRIVE_LOG=info

[Install]
WantedBy=default.target
