#
# The Flarebox sync daemon as a systemd user service. Pair and link first (flarebox pair, flarebox link), then:
#
#   install -Dm644 flarebox.service ~/.config/systemd/user/flarebox.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now flarebox
#
# Change ExecStart if the flarebox binary is not in ~/.local/bin. Logs: journalctl --user -u flarebox
# To keep syncing while you are logged out: loginctl enable-linger "$USER"

[Unit]
Description=Flarebox sync daemon
Documentation=https://github.com/flarebox-dev/flarebox

[Service]
Type=exec
ExecStart=%h/.local/bin/flarebox daemon
Restart=on-failure
RestartSec=10s
Environment=FLAREBOX_LOG=info

[Install]
WantedBy=default.target
